#!/bin/sh
# Called by /etc/pacman.d/hooks/99-reboot-required.hook (NeedsTargets):
# matched package names arrive on stdin, one per line, and get merged into
# the flag file. /run is tmpfs, so the flag clears itself on reboot — no
# cleanup path needed anywhere. No names, no write.
f=/run/reboot-required
umask 022
names=$(cat)
[ -n "$names" ] || exit 0
{ [ -f "$f" ] && cat "$f"; printf '%s\n' "$names"; } | sort -u > "$f.tmp" && mv "$f.tmp" "$f"
